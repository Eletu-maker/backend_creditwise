# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_URL=jdbc:h2:mem:testdb
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ============================================
# MAIL CONFIGURATION
# ============================================
# For Gmail: Use App Password (16 characters)
# Get it from: https://myaccount.google.com/apppasswords
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate a strong secret key (at least 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# ============================================
# NOTES
# ============================================
# 1. Never share these credentials
# 2. Use different values for dev/staging/production
# 3. Keep this file secure and never commit it to Git
# 4. For Gmail: Enable 2FA and create App Password
