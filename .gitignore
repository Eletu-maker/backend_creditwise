# ============================================
# SENSITIVE FILES - NEVER COMMIT THESE
# ============================================

# Environment files with credentials
.env
.env.*
!.env.example

# Application configuration with secrets
src/main/resources/application-dev.yml
src/main/resources/application-prod.yml
!src/main/resources/application-dev.yml.example
!src/main/resources/application-prod.yml.example
!src/main/resources/application.properties

# Docker compose with credentials
docker-compose.yml
!docker-compose.yml.example

# Personal Postman collections
*postman_collection.json
!*postman_collection.example.json

# ============================================
# IDE FILES
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.project
.classpath
.settings/

