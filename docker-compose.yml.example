# ============================================
# DOCKER COMPOSE CONFIGURATION TEMPLATE
# ============================================
# Copy this file to docker-compose.yml and update with your values
# NEVER commit docker-compose.yml with real credentials!

version: '3.8'

services:
  # MySQL Database
  db:
    image: mysql:8.0
    container_name: creditwise-db
    environment:
      MYSQL_ROOT_PASSWORD: change_this_root_password
      MYSQL_DATABASE: creditwise
      MYSQL_USER: change_this_username
      MYSQL_PASSWORD: change_this_password
    ports:
      - "3306:3306"
    volumes:
      - db_data:/var/lib/mysql
    restart: unless-stopped

  # Application
  app:
    build: .
    container_name: creditwise-app
    ports:
      - "8080:8080"
    environment:
      SPRING_PROFILES_ACTIVE: prod
      DB_URL: jdbc:mysql://db:3306/creditwise
      DB_USERNAME: change_this_username
      DB_PASSWORD: change_this_password
      JWT_SECRET: change_this_to_a_very_long_secure_random_string
      EMAIL_USERNAME: your_email@gmail.com
      EMAIL_PASSWORD: your_gmail_app_password
    depends_on:
      - db
    restart: unless-stopped

volumes:
  db_data:
