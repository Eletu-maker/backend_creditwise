# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to application-prod.yml and fill in your values
# NEVER commit application-prod.yml with real credentials!

# Server Configuration
server:
  port: 8080
  servlet:
    context-path: /

# Database Configuration
spring:
  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/creditwise}
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: ${DB_USERNAME:your_db_username}
    password: ${DB_PASSWORD:your_db_password}
    hikari:
      connection-timeout: 20000
      maximum-pool-size: 10
  
  jpa:
    database-platform: org.hibernate.dialect.MySQLDialect
    hibernate:
      ddl-auto: validate
    show-sql: false
    properties:
      hibernate:
        format_sql: false
  
  # Flyway Configuration
  flyway:
    enabled: true
    url: ${DB_URL:jdbc:mysql://localhost:3306/creditwise}
    user: ${DB_USERNAME:your_db_username}
    password: ${DB_PASSWORD:your_db_password}
    
  # Mail Configuration
  mail:
    host: smtp.gmail.com
    port: 587
    username: ${EMAIL_USERNAME:your_email@gmail.com}
    password: ${EMAIL_PASSWORD:your_app_password}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000

# Logging Configuration
logging:
  level:
    com.creditwise: INFO
    org.springframework: WARN
    org.hibernate: WARN
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
  file:
    name: logs/creditwise.log

# JWT Configuration
jwt:
  secret: ${JWT_SECRET:your_production_jwt_secret_at_least_32_characters_long}
  expiration: 86400000
  refresh-expiration: 604800000

# OTP Configuration
app:
  otp:
    expiry-minutes: 5
  admin:
    email: ${ADMIN_EMAIL:admin@company.com}

# Actuator Configuration
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: when_authorized
